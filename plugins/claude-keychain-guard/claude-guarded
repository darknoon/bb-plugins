#!/bin/sh
# Scope the compatibility shim to this Claude process and its children.
# Resolve once, at launch. Do not pin a removed CLI or change existing sessions.
set -eu
guard_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
target=$(/opt/homebrew/bin/node -e 'process.stdout.write(require("node:fs").realpathSync(process.argv[1]))' /Users/andrew/.local/bin/claude)
test -x "$target" || { echo 'Claude executable is unavailable' >&2; exit 126; }
test "$target" != "$guard_dir/claude-guarded" || exit 126
PATH="$guard_dir/bin:$PATH"
export PATH
if test -f /Users/andrew/.local/state/bb-claude-auth/debug-window.json; then
  exec /opt/homebrew/bin/node "$guard_dir/debug-launch.cjs" "$target" "$@"
fi
exec "$target" "$@"
