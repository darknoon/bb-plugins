{
  "name": "bb-plugin-archive-guard",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "npm run check && bb plugin build"
  },
  "engines": {
    "bb": ">=0.42",
    "bbPluginSdk": ">=0.4.47"
  },
  "bb": {
    "name": "Archive Guard",
    "description": "Archive Guard: marks long-lived infrastructure threads as protected, tells every agent which ones they are, and reports it on Whatsagent when one is archived anyway.",
    "branding": {
      "icon": "Shield"
    },
    "server": "./server.ts"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.47",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "hono": "^4.11.9",
    "better-sqlite3": "^12.0.0",
    "typescript": "^5.7.0"
  }
}
